# ============================================================================
# AURUM BPM Credit Core - Plantilla de Variables de Entorno (.env.example)
# Duplicar este archivo a '.env' y configurar los valores según el entorno.
# ============================================================================

# Puerto del servidor backend HTTP
PORT=3000

# Entorno de ejecución: 'development' | 'production' | 'test'
NODE_ENV=production

# Ruta del archivo de base de datos SQLite (modo WAL automático)
DB_PATH=./creditos.db

# Clave secreta criptográfica para firmas HMAC-SHA256 de roles y tokens bancarios
# IMPORTANTE: Reemplazar por una clave secreta de alta entropía (mínimo 32 caracteres) en producción
AUTH_SECRET=cambiar-por-clave-secreta-hmac-sha256-de-alta-entropia-aurum-2026
