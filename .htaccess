# ============================================================================
# AURUM BPM Credit Core - Configuración Apache / Hostinger (.htaccess)
# ============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Redirección forzada a HTTPS en producción
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Exclusión de rutas del API REST y Chequeo de Salud (/api, /health)
  RewriteRule ^api/ - [L]
  RewriteRule ^health$ - [L]

  # 3. Servir archivos y directorios físicos existentes sin alterar
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. SPA Fallback para enrutamiento en cliente React / Vite
  RewriteRule ^ index.html [L]
</IfModule>

# 5. Cabeceras de Seguridad y Blindaje Bancario en Servidor Web
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Evitar almacenamiento en caché para index.html (garantiza entrega de updates SPA)
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </Files>

  # Caché de alto rendimiento para archivos estáticos versionados
  <FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>

# 6. Blindaje de Archivos Sensibles (Prevención de descargas directas)
<FilesMatch "(^\.env|^\.git|\.db$|\.db-wal$|\.db-shm$|\.log$|\.sqlite$)">
  Require all denied
</FilesMatch>
