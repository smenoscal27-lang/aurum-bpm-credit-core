# ============================================================================
# AURUM BPM Credit Core - .gitignore
# Reglas de exclusión para repositorio Git local y remoto (GitHub / Hostinger)
# ============================================================================

# 1. Dependencias de Node.js (Raíz y Frontend)
node_modules/
*/node_modules/
package-lock.json.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# 2. Compilaciones y Empaquetados (Build artifacts)
dist/
build/
*/dist/
*/build/
frontend-creditos/dist/
frontend-creditos/build/
*.zip
*.tar
*.tar.gz
*.tgz
frontend-creditos.zip

# 3. Base de Datos SQLite y Archivos de Transacciones WAL (Datos Sensibles de Producción)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
creditos.db
creditos.db-wal
creditos.db-shm

# 4. Variables de Entorno y Credenciales Criptográficas (Confidencialidad)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt

# 5. Bitácoras y Logs Forenses de Ciberseguridad
logs/
*.log
logs/security-audit.log

# 6. Caché y Archivos Temporales del Entorno de Ejecución
.vite/
*/.vite/
.eslintcache
.temp/
tmp/
temp/

# 7. Configuración de Editores e IDEs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sublime-workspace
*.sublime-project

# 8. Archivos del Sistema Operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
